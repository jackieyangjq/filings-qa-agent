# Copy to .env (git ignores it) and load it before running, e.g.: set -a; source .env; set +a

# Required for `filings-qa ingest`. SEC EDGAR rejects automated requests (HTTP 403) unless the User-Agent names
# who is asking and gives a contact email: your name or company, a space, then the email address.
# Format: Name email@example.com
# Policy: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Required for `filings-qa ask`: a Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
