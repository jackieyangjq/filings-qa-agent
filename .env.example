# Copy to .env (git ignores it) and load it before running, e.g.: set -a; source .env; set +a

# Required for `filings-qa ingest`. SEC EDGAR rejects automated requests (HTTP 403) unless the User-Agent names
# who is asking and gives a contact email: your name or company, a space, then the email address.
# Format: Name email@example.com
# Policy: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT=

# Required for `filings-qa ask`, `agent`, `evalset build` and `eval`: a Gemini API key
# (https://aistudio.google.com/apikey). The free tier is enough.
GEMINI_API_KEY=

# Optional, for the news tool of `filings-qa agent`: a free Finnhub key (https://finnhub.io/register). With it, news
# headlines come from Finnhub's company news; without it, from the Google News RSS search, which Google offers for
# personal, non-commercial use only.
FINNHUB_API_KEY=
